<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_r24" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/music_open"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:gravity="center_vertical"
            android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/title_static"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart" />

            <ViewFlipper
                android:id="@+id/title_flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoStart="true"
                android:flipInterval="2600"
                android:inAnimation="@anim/ticker_in"
                android:outAnimation="@anim/ticker_out"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart" />
        </LinearLayout>

        <ImageView
            android:id="@+id/prev"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/music_previous"
            android:scaleType="center" />

        <ImageView
            android:id="@+id/play"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/music_play_pause"
            android:scaleType="center" />

        <ImageView
            android:id="@+id/next"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/music_next"
            android:scaleType="center" />
    </LinearLayout>
</FrameLayout>
